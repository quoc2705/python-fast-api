APP_NAME="TaskHub — Task Management API"
APP_VERSION="0.5.0"
APP_ENV="development"
DEBUG=false
API_V1_PREFIX="/api/v1"

# Database (SQLite local default, or PostgreSQL / MySQL in Docker)
DATABASE_URL="sqlite+aiosqlite:///./app.db"
DB_ECHO=false

# Security & JWT (Generate with: openssl rand -hex 32)
SECRET_KEY="<CHANGE_ME_GENERATE_WITH_OPENSSL_RAND_HEX_32>"
JWT_ALGORITHM="HS256"
ACCESS_TOKEN_EXPIRE_MINUTES=30
REFRESH_TOKEN_EXPIRE_DAYS=7

# Redis Caching
REDIS_URL="redis://localhost:6379/0"
CACHE_TTL_SECONDS=60
