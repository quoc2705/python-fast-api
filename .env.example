APP_NAME="TaskHub — Task Management API"
APP_VERSION="0.3.0"
APP_ENV="development"
DEBUG=true
API_V1_PREFIX="/api/v1"

# Database (SQLite local default, or PostgreSQL / MySQL in Docker)
DATABASE_URL="sqlite+aiosqlite:///./app.db"
DB_ECHO=false

# Security & JWT
SECRET_KEY="taskhub-super-secret-jwt-key-change-in-production-2026"
JWT_ALGORITHM="HS256"
ACCESS_TOKEN_EXPIRE_MINUTES=30
REFRESH_TOKEN_EXPIRE_DAYS=7

# Redis Caching
REDIS_URL="redis://localhost:6379/0"
CACHE_TTL_SECONDS=60
